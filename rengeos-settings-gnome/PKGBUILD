pkgname=rengeos-settings-gnome
pkgver=1.0
pkgrel=1
pkgdesc="GNOME settings for RengeOS"
arch=('any')
license=('GPLv3')
source=('99_rengeos-gnome.gschema.override'
        '98_rengeos-gnome-console.gschema.override'
        'rengeos.xml'
        'zz_rengeos.org.gnome.login-screen.gschema.override')
sha256sums=('SKIP'
            'SKIP'
            'SKIP'
            'SKIP')

package() {
    install -Dm755 "${srcdir}/99_rengeos-gnome.gschema.override" "${pkgdir}/usr/share/glib-2.0/schemas/99_rengeos-gnome.gschema.override"
    install -Dm755 "${srcdir}/98_rengeos-gnome-console.gschema.override" "${pkgdir}/usr/share/glib-2.0/schemas/98_rengeos-gnome-console.gschema.override"
    install -Dm644 "${srcdir}/rengeos.xml" "${pkgdir}/usr/share/gnome-background-properties/rengeos.xml"
    install -Dm755 "${srcdir}/zz_rengeos.org.gnome.login-screen.gschema.override" "${pkgdir}/usr/share/glib-2.0/schemas/zz_rengeos.org.gnome.login-screen.gschema.override"
}
